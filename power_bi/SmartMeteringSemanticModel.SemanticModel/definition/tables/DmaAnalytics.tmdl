		sourceColumn: meters_with_usage_anomaly

		annotation SummarizationSetBy = Automatic

	measure 'Non-Revenue Water % (estimate)' = DIVIDE(SUM(DmaAnalytics[non_revenue_water_liters]), SUM(DmaAnalytics[estimated_supply_liters]))
		formatString: 0.0%
		lineageTag: e798ef29-812d-4a6a-a529-2f12033973b8


	measure 'DMAs with Leak Flag' = CALCULATE(DISTINCTCOUNT(DmaAnalytics[dma_id]), DmaAnalytics[night_flow_anomaly_flag] = TRUE)
		formatString: #,0
		lineageTag: f6a03cbf-7d31-4e35-859f-94cccfbf097a


	partition DmaAnalytics = entity
		mode: directQuery
		source
			entityName: dma_analytics
			schemaName: gold
			expressionSource: DatabaseQuery

