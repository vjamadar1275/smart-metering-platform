	measure 'High-Usage Customers' = CALCULATE(DISTINCTCOUNT(CustomerAnalytics[customer_id]), CustomerAnalytics[high_usage_flag] = TRUE)
		formatString: #,0
		lineageTag: 93e54822-128e-425b-b324-ac5707844fbc


	measure 'Total Customer Consumption (L)' = SUM(CustomerAnalytics[consumption_liters])
		formatString: #,0
		lineageTag: 223f8955-9778-41e3-bc00-52e7b0bdc55e


	partition CustomerAnalytics = entity
		mode: directQuery
		source
