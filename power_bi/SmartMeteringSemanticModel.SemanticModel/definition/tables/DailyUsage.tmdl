		summarizeBy: none
		sourceColumn: usage_anomaly_flag

		annotation SummarizationSetBy = Automatic

	measure 'Total Consumption (L)' = SUM(DailyUsage[consumption_liters])
		formatString: #,0
		lineageTag: b9c11910-f97e-4906-b8a1-219d51f3973b


	measure 'Anomalous Meter Days' = CALCULATE(COUNTROWS(DailyUsage), DailyUsage[usage_anomaly_flag] = TRUE)
		formatString: #,0
		lineageTag: 835ac626-ec7e-4a9b-a6ef-17ae8f344ee3


	measure 'Active Meters' = DISTINCTCOUNT(DailyUsage[meter_id])
		formatString: #,0
		lineageTag: 4374ee24-597f-4d29-97bd-2c434d49476c


	partition DailyUsage = entity
		mode: directQuery
		source
			entityName: daily_usage
			schemaName: gold
			expressionSource: DatabaseQuery

