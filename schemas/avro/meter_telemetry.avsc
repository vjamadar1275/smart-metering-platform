{
  "type": "record",
  "name": "MeterTelemetry",
  "namespace": "com.smartmeteringplatform.telemetry",
  "doc": "Smart meter telemetry event published by field gateways to the meter-telemetry Event Hub. See docs/architecture/ARCHITECTURE.md#1-field--ingestion. Registered into the 'sg-meter-telemetry' Event Hubs Schema Registry group (schema_compatibility=Backward) — new fields must be optional (nullable with a default) so old consumers keep working against new-firmware producers.",
  "fields": [
    {
      "name": "meter_id",
      "type": "string",
      "doc": "Unique smart meter identifier."
    },
    {
      "name": "reading_timestamp",
      "type": { "type": "long", "logicalType": "timestamp-millis" },
      "doc": "Device-clock timestamp of the reading, UTC milliseconds since epoch."
    },
    {
      "name": "ingest_timestamp",
      "type": { "type": "long", "logicalType": "timestamp-millis" },
      "doc": "Gateway-clock timestamp when the reading was forwarded to Event Hubs, UTC milliseconds since epoch."
    },
    {
      "name": "reading_value",
      "type": "double",
      "doc": "Cumulative volumetric reading, in the unit given by `unit`."
    },
    {
      "name": "unit",
      "type": {
        "type": "enum",
        "name": "ReadingUnit",
        "symbols": ["LITERS", "GALLONS", "CUBIC_METERS"]
      },
      "default": "LITERS"
    },
    {
      "name": "flow_rate",
      "type": ["null", "double"],
      "default": null,
      "doc": "Instantaneous flow rate, liters/minute, if reported by this firmware version."
    },
    {
      "name": "battery_pct",
      "type": ["null", "int"],
      "default": null,
      "doc": "Remaining battery percentage, 0-100, if the meter reports it."
    },
    {
      "name": "signal_quality",
      "type": ["null", "int"],
      "default": null,
      "doc": "RSSI or equivalent signal quality indicator, 0-100."
    },
    {
      "name": "dma_id",
      "type": "string",
      "doc": "District Meter Area this meter belongs to."
    },
    {
      "name": "firmware_version",
      "type": "string"
    },
    {
      "name": "sequence_no",
      "type": "long",
      "doc": "Monotonically increasing per-meter sequence number, used by Silver (Phase 4) for gap/duplicate detection."
    }
  ]
}
